@page "/counter"
@using System.Text.Json
@using ChatApi.Client
@* @implements IDisposable *@

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

<h2>Messages (@Messages.Count)</h2>
<ul>
    @foreach (var msg in Messages)
    {
        <li>@JsonSerializer.Serialize(msg)</li>
    }
    @Messages.Count
</ul>

@code {
    private List<Message> Messages = new List<Message>();
    private int currentCount = 0;
    private static HttpClient httpClient = new HttpClient();
    // private CancellationTokenSource? _cts;

    private ChatApiClient client = new ChatApiClient("http://localhost:5000",httpClient);

    private async Task IncrementCount()
    {
        var res = await client.CreateMessageAsync(new CreateMessageRequest()
        {
            Content = "hi",
            GroupId = "1"
        });
    }

    protected override async Task OnInitializedAsync()
    {
        // _cts = new CancellationTokenSource();
        var sub = new ChatSseClient("http://localhost:5000", httpClient);

        var s = sub.StreamMessagesAsync("1");
        await foreach (var sseMessage in s)
        {
            Messages.Add(sseMessage.Data);
            // await InvokeAsync(StateHasChanged);
        }
