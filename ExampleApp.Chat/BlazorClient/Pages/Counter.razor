        //         await foreach (var sseMessage in stream.WithCancellation(_cts.Token))
        //         {
        //             Messages.Add(sseMessage.Data);
        //             await InvokeAsync(StateHasChanged);
        //         }
        //     }
        //     catch (OperationCanceledException)
        //     {
